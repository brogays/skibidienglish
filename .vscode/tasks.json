{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Lingua Quest localhost",
      "type": "process",
      "command": "py",
      "args": [
        "-3.14",
        "-m",
        "http.server",
        "8080",
        "--bind",
